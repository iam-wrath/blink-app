# Copy this file to .env and change what you need, then restart `npm run dev`.

# Where Kwaku's API lives. Same laptop: leave as is.
# Different laptops: use his IP, e.g. http://192.168.1.20:3000/api
VITE_API_URL=http://localhost:3000/api

# true = never call the API, always show the sample data
VITE_USE_FAKE=false

# Only if Kwaku serves the two pictures at different URLs:
# VITE_IMAGE_A=http://localhost:3000/api/images/a.png
# VITE_IMAGE_B=http://localhost:3000/api/images/b.png
